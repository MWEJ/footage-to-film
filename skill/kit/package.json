    "sheet": "tsx scripts/sheet.ts",
    "fonts": "tsx scripts/fonts.ts",
    "looks": "tsx scripts/looks.ts",
    "draft": "tsx scripts/film.ts --draft",
    "film": "tsx scripts/film.ts",
    "qc": "tsx scripts/qc.ts",
    "preview": "tsx scripts/preview.ts",
    "speech": "tsx scripts/speech.ts",
    "stems": "tsx scripts/stems.ts"
